# ==============================================================================
# Veyroq Staging Environment Template (.env.staging.example)
# Use isolated staging secrets/apps; NEVER reuse production keys here.
# ==============================================================================

# --- Backend Service (Railway / Render Staging) ---
NODE_ENV=production
VEYROQ_ENV=staging
PORT=3000
LOG_LEVEL=debug

# Generate unique staging secret: openssl rand -hex 32
SESSION_SECRET=replace-with-staging-openssl-rand-hex-32

# Dedicated Privy staging App ID
PRIVY_APP_ID=

# Arc Testnet RPC & Verified Testnet VeyroqRegistry
ARC_RPC_URL=https://rpc.testnet.arc.io
VEYROQ_REGISTRY_ADDRESS=0x8A1D55E8E07fa49edF4c0a420b8B033ad03B37B3

# Allow ONLY staging frontend origins (exact scheme + host, no trailing slash)
ALLOWED_ORIGINS=https://staging.veyroq.xyz,https://app-staging.veyroq.xyz,https://status.veyroq.xyz

# Keep false when Vercel proxies /api/* -> VEYROQ_BACKEND_URL (recommended)
VEYROQ_CROSS_SITE_COOKIES=false

# --- Vercel Staging Project Only ---
# Points Vercel's api/index.js proxy at the persistent staging Node server:
# VEYROQ_BACKEND_URL=https://api-staging.veyroq.xyz
