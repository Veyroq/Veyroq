# ==============================================================================
# Veyroq Local Development Environment Template
# Copy to .env (`cp .env.example .env`). NEVER commit .env or real secrets.
# ==============================================================================

# --- Runtime & Logging ---
NODE_ENV=development
VEYROQ_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Session Signing (REQUIRED in staging/production) ---
# Generate 32 random bytes: openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# --- Authentication (Privy Public App ID — keep App Secret out of frontend) ---
PRIVY_APP_ID=

# --- Arc Network & Smart Contract ---
ARC_RPC_URL=https://rpc.testnet.arc.io
VEYROQ_REGISTRY_ADDRESS=0x8A1D55E8E07fa49edF4c0a420b8B033ad03B37B3

# --- Split Hosting: Backend CORS & Vercel First-Party Proxy ---
# On Railway/Render backend: comma-separated allowed frontend origins (never *).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://status.veyroq.xyz
# Set to true ONLY if browser calls Railway/Render directly cross-origin without Vercel /api proxy.
VEYROQ_CROSS_SITE_COOKIES=false
# Set ONLY on Vercel frontend project so /api/* and /health* proxy first-party to Railway/Render:
# VEYROQ_BACKEND_URL=https://api.veyroq.xyz
